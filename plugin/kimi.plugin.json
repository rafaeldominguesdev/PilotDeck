{
  "name": "pilotdeck",
  "version": "0.3.16",
  "description": "Run the complete PilotDeck card workflow from Kimi Code.",
  "keywords": [
    "pilotdeck",
    "task-board",
    "mcp"
  ],
  "author": {
    "name": "PilotDeck"
  },
  "license": "MIT",
  "skills": [
    "./skills/pilotdeck"
  ],
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "*",
      "command": "node \"./hooks/session-start.mjs\"",
      "timeout": 15
    },
    {
      "event": "PostToolUse",
      "matcher": "task_claim|mcp__.*__task_claim|task_deliver|mcp__.*__task_deliver|task_release|mcp__.*__task_release",
      "command": "node \"./hooks/claim-guard.mjs\"",
      "timeout": 15
    },
    {
      "event": "PostToolUse",
      "matcher": "task_deliver|mcp__.*__task_deliver",
      "command": "node \"./hooks/post-deliver.mjs\"",
      "timeout": 30
    },
    {
      "event": "Stop",
      "matcher": "*",
      "command": "node \"./hooks/stop-guard.mjs\"",
      "timeout": 15
    },
    {
      "event": "PreToolUse",
      "matcher": "task_create|mcp__.*__task_create",
      "command": "node \"./hooks/pre-create.mjs\"",
      "timeout": 15
    },
    {
      "event": "PreToolUse",
      "matcher": "*",
      "command": "node \"./hooks/claim-guard.mjs\"",
      "timeout": 15
    }
  ],
  "commands": "./commands"
}
