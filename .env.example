# Copy to .env and adjust. Nothing here is sent off-box.
# Next.js / drizzle read these on the server only — never prefix with NEXT_PUBLIC_.

DATABASE_URL=postgres://pilotdeck:pilotdeck@localhost:5432/pilotdeck
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Secret configured in the GitHub release webhook's X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Hard rule from the spec: no telemetry, analytics, or phone-home.
NEXT_TELEMETRY_DISABLED=1
