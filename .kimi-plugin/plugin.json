{
  "name": "pilotdeck",
  "version": "0.3.16",
  "description": "Run the complete PilotDeck card workflow from Kimi Code.",
  "homepage": "https://github.com/rafaeldominguesdev/pilotdeck",
  "license": "MIT",
  "keywords": ["pilotdeck", "task-board", "mcp"],
  "author": {
    "name": "PilotDeck"
  },
  "skills": ["./plugin/skills/pilotdeck"],
  "commands": "./plugin/commands",
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": "*",
      "command": "node \"./plugin/hooks/session-start.mjs\"",
      "timeout": 15
    },
    {
      "event": "PostToolUse",
      "matcher": "task_claim|mcp__.*__task_claim|task_deliver|mcp__.*__task_deliver|task_release|mcp__.*__task_release",
      "command": "node \"./plugin/hooks/claim-guard.mjs\"",
      "timeout": 15
    },
    {
      "event": "PostToolUse",
      "matcher": "task_deliver|mcp__.*__task_deliver",
      "command": "node \"./plugin/hooks/post-deliver.mjs\"",
      "timeout": 30
    },
    {
      "event": "Stop",
      "matcher": "*",
      "command": "node \"./plugin/hooks/stop-guard.mjs\"",
      "timeout": 15
    },
    {
      "event": "PreToolUse",
      "matcher": "task_create|mcp__.*__task_create",
      "command": "node \"./plugin/hooks/pre-create.mjs\"",
      "timeout": 15
    },
    {
      "event": "PreToolUse",
      "matcher": "*",
      "command": "node \"./plugin/hooks/claim-guard.mjs\"",
      "timeout": 15
    }
  ],
  "interface": {
    "displayName": "PilotDeck",
    "shortDescription": "Claim, execute, and deliver PilotDeck cards",
    "longDescription": "The PilotDeck board workflow as a plugin: the canonical PILOTDECK.md rules, the board MCP server, claim/deliver guards, and the /pilotdeck slash commands. Point it at your own PilotDeck instance.",
    "developerName": "PilotDeck",
    "websiteURL": "https://github.com/rafaeldominguesdev/pilotdeck"
  }
}
